{
  "name": "sushi-sabotage",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.26.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm --filter @sushi/web build",
    "start": "pnpm --filter @sushi/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "sim": "pnpm --filter @sushi/rules sim",
    "assets": "/Applications/Blender.app/Contents/MacOS/Blender -b -P tools/blender/build_assets.py",
    "contract:test": "cd contracts/kitchen && cargo test --locked",
    "contract:build": "cd contracts/kitchen && cargo near build non-reproducible-wasm --locked"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "tsx": "4.20.6"
  }
}
