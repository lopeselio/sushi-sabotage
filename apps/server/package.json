    "@sushi/rules": "workspace:*",
    "near-api-js": "7.4.0",
    "tsx": "4.20.6",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/ws": "8.18.1"
  }
}
